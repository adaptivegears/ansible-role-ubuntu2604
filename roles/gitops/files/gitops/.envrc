#!/usr/bin/env bash
source_up_if_exists

WORKDIR=$(CDPATH="" cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
export WORKDIR

### OpenTofu #################################################################
export OPENTOFU_VERSION=$(tr -d '[:space:]' < "${WORKDIR}/.opentofu-version")
tenv tofu install "${OPENTOFU_VERSION}"
tenv tofu use "${OPENTOFU_VERSION}"
export TG_TF_PATH=tofu

### Terragrunt ################################################################
export TERRAGRUNT_VERSION=$(tr -d '[:space:]' < "${WORKDIR}/.terragrunt-version")
tenv terragrunt install "${TERRAGRUNT_VERSION}"
tenv terragrunt use "${TERRAGRUNT_VERSION}"

### Cache #####################################################################
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export TF_PLUGIN_CACHE_DIR="${XDG_CACHE_HOME}/opentofu/plugin-cache"
export TG_DOWNLOAD_DIR="${WORKDIR}/.terragrunt-cache"
mkdir -p "${TF_PLUGIN_CACHE_DIR}" "${TG_DOWNLOAD_DIR}"
